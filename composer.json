{
	"name": "fraudnova/fraudnova-wordpress",
	"description": "FraudNova fraud detection for WooCommerce and forms.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"brain/monkey": "^2.6",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/wordpress-stubs": "^6.9",
		"php-stubs/woocommerce-stubs": "^9.0",
		"wp-cli/i18n-command": "^2.6",
		"wp-cli/wp-cli": "^2.11"
	},
	"config": {
		"platform": {
			"php": "7.4.33"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"autoload-dev": {
		"psr-4": {
			"FraudNova\\WordPress\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit",
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"make-pot": "@php vendor/wp-cli/wp-cli/php/boot-fs.php i18n make-pot . languages/fraudnova.pot --slug=fraudnova --domain=fraudnova --exclude=vendor,tests,dist,node_modules --headers='{\"Project-Id-Version\":\"FraudNova 1.0.0\",\"Report-Msgid-Bugs-To\":\"https://github.com/dahleedam/fraudnova-wordpress/issues\"}'"
	}
}
